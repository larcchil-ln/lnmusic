{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/lnmusic.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"LNMusic.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/import?_fn=config"
    },
    {
      "source": "/api/resolve",
      "destination": "/api/import?_fn=resolve"
    }
  ]
}
